# stock-quant — 환경변수 템플릿 (보고서 §5.3, 경로 A / Python)
# 복사: cp .env.example .env  —  .env 는 절대 커밋 금지 (.gitignore)

# --- LLM (공정가치 추정) ---
ANTHROPIC_API_KEY="sk-ant-..."          # Claude (권장)
# OPENAI_API_KEY="sk-..."               # 선택

# --- 지갑 / 거래 (라이브 실행 시에만 필요) ---
# 에이전트 전용 지갑을 메인 지갑과 분리할 것 (리스크 격리, §5.3 danger)
POLYGON_WALLET_PRIVATE_KEY="0x..."

# --- 안전 스위치 ---
# 라이브 주문을 켜려면 명시적으로 "false" 로 변경. 비우거나 다른 값이면 dry-run(페이퍼).
DRY_RUN="true"

# --- 선택: 튜닝 가능한 가드레일 (미설정 시 코드 기본값 사용) ---
# EDGE_THRESHOLD="0.08"     # 최소 괴리 8%
# MAX_FRACTION="0.06"       # Kelly 상한 6%
# MAX_DAILY_LOSS_PCT="0.20"
# MAX_POSITIONS="10"
# MIN_LIQUIDITY="1000"
# LOOP_MINUTES="10"
# CLAUDE_MODEL="claude-opus-4-8"   # 비용 절감 시 haiku 계열
