# stock-quant — 환경변수 템플릿 (보고서 §5.3, 경로 A / Python)
# 복사: cp .env.example .env  —  .env 는 절대 커밋 금지 (.gitignore)

# --- LLM (공정가치 추정) ---
ANTHROPIC_API_KEY="sk-ant-..."          # Claude (권장)
# OPENAI_API_KEY="sk-..."               # 선택

# --- 지갑 / 거래 (라이브 실행 시에만 필요) ---
# 에이전트 전용 지갑을 메인 지갑과 분리할 것 (리스크 격리, §5.3 danger)
POLYGON_WALLET_PRIVATE_KEY="0x..."
# 지갑 유형별 서명 타입: 0=EOA(기본), 1=email/magic proxy, 2=browser safe.
# proxy/safe 사용 시 자금 보유 주소를 funder 로 지정.
# CLOB_SIGNATURE_TYPE="0"
# CLOB_FUNDER_ADDRESS="0x..."
# 사전조건: 위 지갑에 USDC(Polygon) 보유 + CLOB Exchange 에 USDC approve 1회 설정 필요.

# --- 안전 스위치 ---
# 라이브 주문을 켜려면 명시적으로 "false" 로 변경. 비우거나 다른 값이면 dry-run(페이퍼).
DRY_RUN="true"

# --- 데이터 소스 (§5.2, 선택) ---
# NOAA(날씨)·CoinGecko(크립토)·ESPN(스포츠)·Nominatim(지오코딩)은 키 불필요.
# NOAA/Nominatim 정책상 연락처 포함 User-Agent 권장:
# HTTP_USER_AGENT="stock-quant/0.0.1 (research; you@example.com)"
# 뉴스 fallback 은 키 있을 때만 동작 (newsapi.org):
# NEWS_API_KEY=""
# HTTP_TIMEOUT="10"

# --- 선택: 튜닝 가능한 가드레일 (미설정 시 코드 기본값 사용) ---
# EDGE_THRESHOLD="0.08"     # 최소 괴리 8%
# MAX_FRACTION="0.06"       # Kelly 상한 6%
# MAX_DAILY_LOSS_PCT="0.20"
# MAX_POSITIONS="10"
# MIN_LIQUIDITY="1000"
# LOOP_MINUTES="10"
# CLAUDE_MODEL="claude-opus-4-8"   # 비용 절감 시 haiku 계열
